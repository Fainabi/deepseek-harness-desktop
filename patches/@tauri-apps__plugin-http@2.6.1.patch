diff --git a/dist-js/index.cjs b/dist-js/index.cjs
index 18b6c78e7102523d557430eaae94d839fcef0cb0..2cb973bbf68502a1b21132a9eb3561015ed97c68 100644
--- a/dist-js/index.cjs
+++ b/dist-js/index.cjs
@@ -29,6 +29,13 @@ var core = require('@tauri-apps/api/core');
  * @module
  */
 const ERROR_REQUEST_CANCELLED = 'Request cancelled';
+// Header names/values must be ISO-8859-1: GitHub adds a `content-disposition`
+// carrying the raw file name, so any asset with a non-Latin name (all dsh-pet
+// animations) makes `new Headers(...)` throw and fails the whole fetch.
+const ISO_8859_1_ONLY = /^[\u0000-\u00ff]*$/;
+function toResponseHeaders(rawHeaders) {
+    return new Headers(rawHeaders.filter(([name, value]) => ISO_8859_1_ONLY.test(name) && ISO_8859_1_ONLY.test(value)));
+}
 /**
  * Fetch a resource from the network. It returns a `Promise` that resolves to the
  * `Response` to that `Request`, whether it is successful or not.
@@ -175,7 +182,7 @@ async function fetch(input, init) {
     // browsers, where `set-cookie` is treated as a forbidden response
     // header and is generally not readable from JavaScript.
     Object.defineProperty(res, 'headers', {
-        value: new Headers(responseHeaders),
+        value: toResponseHeaders(responseHeaders),
         writable: false
     });
     // Patch clone() per-instance so cloning preserves the overridden properties
@@ -185,7 +192,7 @@ async function fetch(input, init) {
             const cloned = originalClone();
             Object.defineProperty(cloned, 'url', { value: url, writable: false });
             Object.defineProperty(cloned, 'headers', {
-                value: new Headers(responseHeaders),
+                value: toResponseHeaders(responseHeaders),
                 writable: false
             });
             return cloned;
